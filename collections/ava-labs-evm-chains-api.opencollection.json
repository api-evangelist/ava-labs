                "type": "path",
                "description": "alpha-numeric subnetID"
              },
              {
                "name": "from",
                "value": "1654819200",
                "type": "query",
                "description": "From date in UNIX Timestamp."
              },
              {
                "name": "to",
                "value": "1655424000",
                "type": "query",
                "description": "To date in UNIX Timestamp."
