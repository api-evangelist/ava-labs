{
  "opencollection": "1.0.0",
  "info": {
    "name": "Data AVAX Supply Health Check API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-glacier-api-key",
      "value": "{{x-glacier-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Health Check",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get the health of the service",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://glacier-api.avax.network/v1/health-check"
          },
          "docs": "Check the health of the service."
        },
        {
          "info": {
            "name": "Get the health of the service",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://glacier-api.avax.network/v2/health-check"
          },
          "docs": "Check the health of the service."
        }
      ]
    }
  ],
  "bundled": true
}